# ============================================================
# CAREER ODYSSEY — ENVIRONMENT CONFIGURATION (SAMPLE)
# ============================================================

# Server Port
PORT=5000

# Application Environment (development, test, production)
NODE_ENV=development

# MongoDB Connection String
# Example: mongodb://localhost:27017/careerodyssey or MongoDB Atlas URI
MONGO_URI=mongodb://localhost:27017/careerodyssey

# JWT Secret for signing authentication tokens (Generate a strong random string in production)
JWT_SECRET=your_jwt_secret_key_change_in_production

# Frontend Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional: Google Gemini AI API Key (if AI features are enabled)
# GEMINI_API_KEY=your_gemini_api_key_here
